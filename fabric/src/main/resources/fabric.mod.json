{
	"schemaVersion": 1,
	"id": "visual_health",
	"version": "${version}",
	"name": "Visual Health",
	"description": "Add visible damage to hurt mobs!",
	"authors": [
		"Halfstorm"
	],
	"contact": {
		"homepage": "https://github.com/demistorm/Visual-Health",
		"issues": "https://github.com/demistorm/Visual-Health/issues",
		"sources": "https://github.com/demistorm/Visual-Health"
	},
	"license": "GPL-3.0",
	"icon": "vh-logo.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"win.demistorm.visual_health.fabric.VisualHealthFabric"
		],
		"client": [
			"win.demistorm.visual_health.fabric.client.FabricClient"
		],
		"modmenu": [
			"win.demistorm.visual_health.fabric.client.FabricConfigScreen"
		]
	},
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "${minecraft_version}",
		"java": ">=17",
		"fabric-api": "*"
	},
	"mixins": [
		"visualhealth.mixins.json"
	],
	"accessWidener": "visualhealth.accesswidener",
	"suggests": {
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/7uttzPbTGq",
				"modmenu.kofi": "https://ko-fi.com/hstorm"
			}
		}
	}
