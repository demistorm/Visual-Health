package win.demistorm.visual_health.client.mixin.etf;

import net.minecraft.resources.Identifier;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfoReturnable;
import traben.entity_texture_features.features.ETFRenderContext;
import traben.entity_texture_features.features.state.ETFEntityRenderState;
import trababen.entity_texture_features.features.texture_handlers.ETFTexture;
import win.demistorm.visual_health.client.texture.HealthTierCalculator;
import win.demistorm.visual_health.client.texture.TextureDamageManager;
import win.demistorm.visual_health.client.texture.WoundStampRenderer;

// Optional mixin for ETF emissive texture support
// Only loads if ETF (Entity Texture Features) is present
// Applies dark damage tint to emissive (glowing) textures
@Mixin(ETFTexture.class)
public class ETFTextureMixin {

    // Inject into getEmissiveIdentifierOfCurrentState to damage emissive textures
    // This intercepts after ETF has selected the appropriate emissive variant
    @Inject(
            method = "getEmissiveIdentifierOfCurrentState",
            at = @At("RETURN"),
            cancellable = true,
            require = 0  // Optional mixin - don't fail if ETF is not present
    )
    private void visualhealth$damageEmissiveTexture(CallbackInfoReturnable<Identifier> cir) {
        Identifier emissiveTexture = cir.getReturnValue();

        // Skip if no emissive texture
        if (emissiveTexture == null) {
            return;
        }

        // Get current entity from ETF's render context
        ETFEntityRenderState state = ETFRenderContext.getCurrentEntity();
        if (state == null) {
            return;
        }

        // Get the actual LivingEntity from the state
        Object entityObj = state.entity();
        if (!(entityObj instanceof net.minecraft.world.entity.LivingEntity entity)) {
            return; // Only apply to living entities
        }

        // Calculate damage tier
        int damageTier = HealthTierCalculator.getDamageTier(entity);

        // If no damage needed, return original emissive
        if (damageTier == 0) {
            return;
        }

        // Get or create damaged emissive texture with dark tint
        // Emissive textures get dark gray tint instead of red (glowing parts don't bleed bright red)
        Identifier damagedEmissive = TextureDamageManager.getOrCreateDamagedTexture(
                entity,
                emissiveTexture,
                damageTier,
                WoundStampRenderer.EMISSIVE_TINT  // Dark gray for emissives
        );

        // Return the damaged emissive texture
        if (damagedEmissive != null) {
            cir.setReturnValue(damagedEmissive);
        }
    }
}
